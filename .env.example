# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TRANSCRIPTION_API_KEY=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
# Local dev: SQLite. Supabase: Project Settings -> Database -> connection string
# (session mode / direct), e.g. postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=sqlite:///./cercania.db
# Supabase Storage (audio, images, documents). Service key is backend-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
MAGIC_LINK_TTL_MINUTES=15
PUBLIC_BASE_URL=
