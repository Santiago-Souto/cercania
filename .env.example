# Copy to .env and fill in. Never commit .env.
# Groq: transcription (Whisper) and, by default, checklist extraction.
GROQ_API_KEY=

# LLM vendor (backend/app/llm.py). Each model setting takes <provider>:<model>:
#   groq:<model>       uses GROQ_API_KEY
#   anthropic:<model>  uses ANTHROPIC_API_KEY
#   openai:<model>     any other OpenAI-compatible endpoint (OpenAI, xAI, OpenRouter, Ollama...),
#                      using LLM_BASE_URL (default https://api.openai.com/v1) and LLM_API_KEY.
#   e.g. EXTRACT_MODEL=openai:grok-4-0709 LLM_BASE_URL=https://api.x.ai/v1
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# Optional: extraction model (default groq:openai/gpt-oss-120b).
EXTRACT_MODEL=
# Optional: emergency triage model (default groq:openai/gpt-oss-120b).
TRIAGE_MODEL=

# WhatsApp (Meta Cloud API). See docs/whatsapp-setup.md for where each value comes from.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Local dev: SQLite (default if empty).
# Supabase: dashboard -> Connect -> "Session pooler" string (IPv4, works from Render).
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Copy the host exactly from the dashboard. SSL (sslmode=require) is added by the backend.
DATABASE_URL=sqlite:///./cercania.db
# Supabase Storage (audio, images, documents). Service key is backend-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
# Login code by SMS (Twilio). Use TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
# A trial account only texts numbers verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
LOGIN_CODE_TTL_MINUTES=10
SESSION_TTL_DAYS=30
# Session cookie. Deploy: leave both empty (SameSite=None; Secure, web and API are different sites).
# Local http dev: SESSION_COOKIE_SECURE=0 and SESSION_COOKIE_SAMESITE=lax.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
# SIMULATED delivery for local dev without Twilio: 1 = write the login code to the API log. Never in a deploy.
AUTH_DEV_LOG_CODES=
PUBLIC_BASE_URL=

# SIMULATED identity for the web app until login exists: honors the X-Person-Id header.
# Only for local dev / demo with fictional data. Leave empty in any real deploy.
ALLOW_DEV_IDENTITY_HEADER=

# Origins allowed to call the API from a browser (comma-separated). Unset = none.
WEB_ORIGINS=http://localhost:3000
# 1 = also send emergency notifications by WhatsApp (the web inbox is always used)
NOTIFY_WHATSAPP=0
# Emergency notifications by WhatsApp (only with NOTIFY_WHATSAPP=1): approved template used
# when the recipient has not written to the bot in the last 24 h (Meta error 131047).
WHATSAPP_EMERGENCY_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es
# Times shown in notifications and to the query model.
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Optional model override for the cited query, "<provider>:<model>" like the other
# *_MODEL settings (default groq:openai/gpt-oss-120b; see backend/app/llm.py).
QUERY_MODEL=

# Web (web/.env.local)
NEXT_PUBLIC_USE_FAKE_DATA=1
NEXT_PUBLIC_API_URL=http://localhost:8000
