# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the extraction model (default claude-haiku-5-5).
EXTRACT_MODEL=
# Optional: override the emergency triage model (default claude-haiku-5-5).
TRIAGE_MODEL=

# Transcription (Groq Whisper)
GROQ_API_KEY=

# WhatsApp (Meta Cloud API). See docs/whatsapp-setup.md for where each value comes from.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Local dev: SQLite (default if empty).
# Supabase: dashboard -> Connect -> "Session pooler" string (IPv4, works from Render).
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Copy the host exactly from the dashboard. SSL (sslmode=require) is added by the backend.
DATABASE_URL=sqlite:///./cercania.db
# Supabase Storage (audio, images, documents). Service key is backend-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
MAGIC_LINK_TTL_MINUTES=15
PUBLIC_BASE_URL=

# SIMULATED identity for the web app until login exists: honors the X-Person-Id header.
# Only for local dev / demo with fictional data. Leave empty in any real deploy.
ALLOW_DEV_IDENTITY_HEADER=

# Origins allowed to call the API from a browser (comma-separated).
WEB_ORIGINS=http://localhost:3000
# 1 = also send emergency notifications by WhatsApp (the web inbox is always used)
NOTIFY_WHATSAPP=0
